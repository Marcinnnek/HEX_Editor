<Window x:Class="HexEditor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HexEditor.UI"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="HEX Editor" Height="620" Width="980" MinHeight="420" MinWidth="640"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SegmentListStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="12">
        <Menu DockPanel.Dock="Top" Margin="0,0,0,8">
            <ui:MenuItem Header="_File">
                <ui:MenuItem x:Name="OpenMenuItem" Header="Open HEX / S-Record..." Click="OpenImage_Click" IsEnabled="{Binding ViewModel.CanStartOpenCompareOrMerge}" InputGestureText="Ctrl+O" />
                <Separator />
                <ui:MenuItem x:Name="SaveMenuItem" Header="Save" Click="Save_Click" IsEnabled="{Binding ViewModel.ActiveCanSave}" InputGestureText="Ctrl+S" />
                <ui:MenuItem Header="Save As..." Click="SaveAs_Click" IsEnabled="{Binding ViewModel.ActiveCanSaveAs}" InputGestureText="Ctrl+Shift+S" />
                <ui:MenuItem Header="Close Image" Click="CloseImage_Click" IsEnabled="{Binding ViewModel.ActiveCanCloseImage}" InputGestureText="Ctrl+W" />
                <Separator />
                <ui:MenuItem Header="Export Image..." Click="ExportImage_Click" IsEnabled="{Binding ViewModel.ActiveHasImage}" />
                <ui:MenuItem Header="Export Selected Segments..." Click="ExportSegments_Click" IsEnabled="{Binding ViewModel.ActiveHasImage}" />
                <ui:MenuItem Header="Export Address Range..." Click="ExportRange_Click" IsEnabled="{Binding ViewModel.ActiveHasImage}" />
            </ui:MenuItem>
            <ui:MenuItem x:Name="EditMenuItem" Header="_Edit" IsEnabled="{Binding ViewModel.CanEdit}">
                <ui:MenuItem Header="Undo" Click="Undo_Click" IsEnabled="{Binding ViewModel.ActiveCanUndo}" InputGestureText="Ctrl+Z" />
                <ui:MenuItem Header="Redo" Click="Redo_Click" IsEnabled="{Binding ViewModel.ActiveCanRedo}" InputGestureText="Ctrl+Y" />
                <Separator />
                <ui:MenuItem Header="Edit / Insert" Click="EditInsert_Click" />
                <ui:MenuItem Header="Fill range" Click="Fill_Click" />
                <ui:MenuItem Header="Copy range" Click="Copy_Click" IsEnabled="{Binding ViewModel.ActiveHasSelection}" />
                <ui:MenuItem Header="Cut range" Click="Cut_Click" IsEnabled="{Binding ViewModel.ActiveHasSelection}" />
                <ui:MenuItem Header="Paste at start" Click="Paste_Click" IsEnabled="{Binding ViewModel.ActiveCanPaste}" />
                <ui:MenuItem Header="Delete range" Click="Delete_Click" IsEnabled="{Binding ViewModel.ActiveHasSelection}" />
            </ui:MenuItem>
            <ui:MenuItem Header="_View">
                <ui:MenuItem Header="8 bytes per row" Click="RowWidth8_Click" />
                <ui:MenuItem Header="16 bytes per row" Click="RowWidth16_Click" />
                <ui:MenuItem Header="32 bytes per row" Click="RowWidth32_Click" />
                <Separator />
                <ui:MenuItem Header="Show ASCII" IsCheckable="True" IsChecked="{Binding ViewModel.ActiveShowAscii, Mode=TwoWay}" />
                <ui:MenuItem Header="Go to address" Click="GoToAddressDialog_Click" InputGestureText="Ctrl+G" />
                <ui:MenuItem Header="Find bytes..." Click="FindBytes_Click" InputGestureText="Ctrl+F" />
                <ui:MenuItem Header="Select range" Click="SelectRange_Click" IsEnabled="{Binding ViewModel.ActiveHasImage}" />
            </ui:MenuItem>
            <ui:MenuItem x:Name="CompareMenuItem" Header="_Compare" IsEnabled="{Binding ViewModel.CanStartOpenCompareOrMerge}">
                <ui:MenuItem Header="Compare images..." Click="CompareImages_Click" />
            </ui:MenuItem>
            <ui:MenuItem x:Name="MergeMenuItem" Header="_Merge" IsEnabled="{Binding ViewModel.CanStartOpenCompareOrMerge}">
                <ui:MenuItem Header="Merge images..." Click="MergeImages_Click" />
            </ui:MenuItem>
            <ui:MenuItem Header="_Tools" IsEnabled="{Binding ViewModel.CanEdit}">
                <ui:MenuItem Header="Checksum / Calculate..." Click="CalculateChecksum_Click" />
                <ui:MenuItem Header="Relocate selected segment" Click="RelocateSegment_Click" IsEnabled="{Binding ViewModel.ActiveCanRelocate}" />
            </ui:MenuItem>
            <ui:MenuItem Header="_Preferences..." Click="Preferences_Click" />
            <ui:MenuItem Header="E_xport">
                <ui:MenuItem Header="Export Image..." Click="ExportImage_Click" />
                <ui:MenuItem Header="Export Selected Segments..." Click="ExportSegments_Click" />
                <ui:MenuItem Header="Export Address Range..." Click="ExportRange_Click" />
            </ui:MenuItem>
        </Menu>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Border DockPanel.Dock="Top" x:Name="FileOperationPanel" Visibility="Collapsed" BorderBrush="{DynamicResource HexBorderBrush}" BorderThickness="1" Padding="6" Margin="0,0,0,6">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="Cancel" Padding="10,3" Click="CancelFileOperation_Click" />
                    <StackPanel>
                        <TextBlock x:Name="FileOperationText" Text="Working..." Margin="0,0,0,3" />
                        <ProgressBar x:Name="FileOperationProgress" Height="8" IsIndeterminate="True" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <ToolBarTray DockPanel.Dock="Top" x:Name="PrimaryToolBarTray" SizeChanged="PrimaryToolBarTray_SizeChanged" IsLocked="True" ToolTip="Primary commands">
                <ToolBar x:Name="FileToolBar" ToolTip="File">
                    <ui:Button Content="Open" Click="OpenImage_Click" IsEnabled="{Binding ViewModel.CanStartOpenCompareOrMerge}" ToolTip="Open HEX / S-Record (Ctrl+O)" />
                    <ui:Button Content="Save" Click="Save_Click" IsEnabled="{Binding ViewModel.ActiveCanSave}" ToolTip="Save active base (Ctrl+S)" />
                </ToolBar>
                <ToolBar x:Name="CompareToolBar" ToolTip="Compare / Merge">
                    <ui:Button Content="Compare" Click="CompareImages_Click" IsEnabled="{Binding ViewModel.CanStartOpenCompareOrMerge}" />
                    <ui:Button Content="Merge" Click="MergeImages_Click" IsEnabled="{Binding ViewModel.CanStartOpenCompareOrMerge}" />
                </ToolBar>
                <ToolBar x:Name="HistoryToolBar" ToolTip="History">
                    <ui:Button Content="Undo" Click="Undo_Click" IsEnabled="{Binding ViewModel.ActiveCanUndo}" />
                    <ui:Button Content="Redo" Click="Redo_Click" IsEnabled="{Binding ViewModel.ActiveCanRedo}" />
                </ToolBar>
                <ToolBar x:Name="ViewToolBar" ToolTip="View">
                    <ComboBox Width="64" Style="{StaticResource {x:Type ComboBox}}" ToolTip="Bytes per row" ItemsSource="{Binding ViewModel.RowWidths}"
                              SelectedItem="{Binding ViewModel.ActiveBytesPerRow, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="ASCII" ToolTip="Show ASCII" IsChecked="{Binding ViewModel.ActiveShowAscii, UpdateSourceTrigger=PropertyChanged}"
                              VerticalAlignment="Center" Padding="4,0" />
                </ToolBar>
            </ToolBarTray>
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock>
                <Run Text="Address: " /><Run Text="{Binding ViewModel.EditorStatus.CurrentAddressText, Mode=OneWay}" />
                <Run Text="    Selection: " /><Run Text="{Binding ViewModel.EditorStatus.SelectionLength, Mode=OneWay}" /><Run Text=" byte(s)" />
                <Run Text="    Format: " /><Run Text="{Binding ViewModel.EditorStatus.ImageFormatText, Mode=OneWay}" />
                <Run Text="    State: " /><Run Text="{Binding ViewModel.EditorStatus.ModifiedStateText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Margin="0,3,0,0" Text="{Binding ViewModel.StatusMessage}" />
        </StackPanel>
        <TabControl x:Name="WorkspaceTabs" SelectionChanged="WorkspaceTabs_SelectionChanged">
            <TabItem Header="Editor">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ListBox Grid.Row="0" x:Name="SegmentsGrid" ItemsSource="{Binding ViewModel.Segments}"
                             HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                             SelectionMode="Extended" SelectionChanged="SegmentsGrid_SelectionChanged"
                             MouseDoubleClick="SegmentsGrid_MouseDoubleClick"
                             MaxHeight="150" MinHeight="72"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False"
                             ItemContainerStyle="{StaticResource MemoryBlockListItemContainerStyle}"
                             ItemTemplate="{StaticResource MemoryBlockListItemTemplate}">
                    </ListBox>
                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <local:HexViewControl Grid.Row="2" x:Name="HexRowsView"
                                          ItemsSource="{Binding ViewModel.ImageView.Rows}"
                                          UseWindowedScrolling="True"
                                          ShowAscii="{Binding ViewModel.ImageView.ShowAscii}"
                                          AddressRangeSelected="HexView_AddressRangeSelected">
                        <local:HexViewControl.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Select Range..." Click="SelectRange_Click" />
                                <Separator />
                                <MenuItem Header="Edit / Insert..." Click="EditInsert_Click" />
                                <MenuItem Header="Fill Range..." Click="Fill_Click" />
                            </ContextMenu>
                        </local:HexViewControl.ContextMenu>
                    </local:HexViewControl>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
