<Window x:Class="HexEditor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HexEditor.UI"
        mc:Ignorable="d"
        Title="HEX Editor" Height="620" Width="980" MinHeight="420" MinWidth="640">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
                <Button Content="Open HEX / S-Record" Padding="10,5" Click="OpenImage_Click" Margin="0,0,6,0" />
                <Button Content="Compare images" Padding="10,5" Click="CompareImages_Click" Margin="0,0,6,0" />
                <Button Content="Merge images" Padding="10,5" Click="MergeImages_Click" Margin="0,0,6,0" />
                <Button Content="Save" Padding="10,5" Click="Save_Click" Margin="0,0,6,0" />
                <Button Content="Save As" Padding="10,5" Click="SaveAs_Click" Margin="0,0,6,0" />
                <Button Content="Close Image" Padding="10,5" Click="CloseImage_Click" Margin="0,0,6,0" />
                <Button Content="Undo" Padding="10,5" Click="Undo_Click" Margin="0,0,6,0" IsEnabled="{Binding ViewModel.CanUndo}" />
                <Button Content="Redo" Padding="10,5" Click="Redo_Click" Margin="0,0,12,0" IsEnabled="{Binding ViewModel.CanRedo}" />
                <TextBlock Text="Bytes per row" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="65" ItemsSource="{Binding ViewModel.RowWidths}"
                          SelectedItem="{Binding ViewModel.ImageView.BytesPerRow, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="Show ASCII" IsChecked="{Binding ViewModel.ImageView.ShowAscii, UpdateSourceTrigger=PropertyChanged}"
                          VerticalAlignment="Center" Margin="12,0,12,0" />
                <TextBlock Text="Go to" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="AddressInput" Width="90" VerticalContentAlignment="Center" />
                <Button Content="Go" Padding="8,4" Margin="4,0,0,0" Click="GoToAddress_Click" />
                <Button Content="Relocate selected segment" Padding="8,4" Margin="8,0,0,0" Click="RelocateSegment_Click" />
            </WrapPanel>
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Start" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox x:Name="RangeStartInput" Width="85" Text="00000000" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="End" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox x:Name="RangeEndInput" Width="85" Text="00000000" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                <Button Content="Select range" Click="SelectRange_Click" Padding="8,4" Margin="0,0,6,0" ToolTip="Select the inclusive address range above" />
                <TextBox x:Name="PatternInput" Width="130" ToolTip="Byte or repeating hexadecimal pattern, for example 00 FF" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                <Button Content="Edit / Insert" Click="EditInsert_Click" Padding="8,4" Margin="0,0,4,0" />
                <Button Content="Fill" Click="Fill_Click" Padding="8,4" Margin="0,0,4,0" />
                <Button Content="Copy" Click="Copy_Click" Padding="8,4" Margin="0,0,4,0" />
                <Button Content="Cut" Click="Cut_Click" Padding="8,4" Margin="0,0,4,0" />
                <Button Content="Paste at Start" Click="Paste_Click" Padding="8,4" Margin="0,0,4,0" />
                <Button Content="Delete" Click="Delete_Click" Padding="8,4" />
            </WrapPanel>
            <WrapPanel Margin="0,6,0,0" VerticalAlignment="Center">
                <TextBlock Text="Checksum" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="ChecksumAlgorithmInput" Width="170" SelectedIndex="0" Margin="0,0,6,0">
                    <ComboBoxItem Content="Additive" />
                    <ComboBoxItem Content="CRC-16/CCITT-FALSE" />
                    <ComboBoxItem Content="CRC-32/ISO-HDLC" />
                    <ComboBoxItem Content="Custom CRC" />
                </ComboBox>
                <TextBlock Text="Width" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="ChecksumWidthInput" Width="55" SelectedIndex="0" Margin="0,0,6,0">
                    <ComboBoxItem Content="8" />
                    <ComboBoxItem Content="16" />
                    <ComboBoxItem Content="32" />
                </ComboBox>
                <TextBlock Text="Holes" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="MissingTreatmentInput" Width="95" SelectedIndex="0" Margin="0,0,6,0">
                    <ComboBoxItem Content="Reject" />
                    <ComboBoxItem Content="Fill byte" />
                </ComboBox>
                <TextBox x:Name="HoleFillByteInput" Width="45" ToolTip="Fill byte in hex" Text="FF" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="Order" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="ChecksumByteOrderInput" Width="100" SelectedIndex="0" Margin="0,0,6,0">
                    <ComboBoxItem Content="Big endian" />
                    <ComboBoxItem Content="Little endian" />
                </ComboBox>
                <TextBox x:Name="ChecksumPolynomialInput" Width="72" Text="1021" ToolTip="Custom CRC polynomial in hex" VerticalContentAlignment="Center" Margin="0,0,4,0" />
                <TextBox x:Name="ChecksumInitialInput" Width="72" Text="FFFF" ToolTip="Custom CRC initial value in hex" VerticalContentAlignment="Center" Margin="0,0,4,0" />
                <CheckBox x:Name="ReflectInputCheckBox" Content="RefIn" VerticalAlignment="Center" Margin="0,0,4,0" />
                <CheckBox x:Name="ReflectOutputCheckBox" Content="RefOut" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox x:Name="ChecksumFinalXorInput" Width="72" Text="0" ToolTip="Custom CRC final XOR in hex" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                <Button Content="Calculate" Click="CalculateChecksum_Click" Padding="8,4" Margin="0,0,4,0" />
                <TextBlock Text="Write at" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox x:Name="ChecksumWriteAddressInput" Width="80" Text="00000000" VerticalContentAlignment="Center" Margin="0,0,4,0" />
                <Button Content="Write result" Click="WriteChecksum_Click" Padding="8,4" />
            </WrapPanel>
            <TextBlock Text="{Binding ViewModel.ChecksumSummary}" Margin="0,4,0,0" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ViewModel.ChecksumResult.Parameters}" />
            <WrapPanel VerticalAlignment="Center" Margin="0,0,0,6">
                <TextBlock Text="Export as" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="ExportFormatInput" Width="150" ItemsSource="{Binding ViewModel.ExportFormats}" SelectedIndex="0" />
                <TextBlock Text="Max record bytes" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox x:Name="ExportPayloadInput" Width="64" ItemsSource="{Binding ViewModel.ExportPayloadSizes}" SelectedIndex="1" />
                <Button Content="Export selected segments" Padding="10,4" Margin="12,0,0,0" Click="ExportSegments_Click" />
                <TextBlock Text="or range" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox x:Name="ExportRangeStartInput" Width="90" ToolTip="Start address (hex)" VerticalContentAlignment="Center" />
                <TextBlock Text="to" VerticalAlignment="Center" Margin="6,0" />
                <TextBox x:Name="ExportRangeEndInput" Width="90" ToolTip="End address (hex)" VerticalContentAlignment="Center" />
                <Button Content="Export range" Padding="10,4" Margin="6,0,0,0" Click="ExportRange_Click" />
            </WrapPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock>
                <Run Text="Address: " /><Run Text="{Binding ViewModel.CurrentAddressText}" />
                <Run Text="    Selection: " /><Run Text="{Binding ViewModel.SelectionLength}" /><Run Text=" byte(s)" />
                <Run Text="    Format: " /><Run Text="{Binding ViewModel.ImageFormatText}" />
                <Run Text="    State: " /><Run Text="{Binding ViewModel.ModifiedStateText}" />
            </TextBlock>
            <TextBlock Margin="0,3,0,0" Text="{Binding ViewModel.StatusMessage}" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DataGrid Grid.Column="0" x:Name="SegmentsGrid" ItemsSource="{Binding ViewModel.Segments}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" SelectionMode="Extended" SelectionChanged="SegmentsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Start Address" Binding="{Binding StartAddress}" Width="*" />
                    <DataGridTextColumn Header="End Address" Binding="{Binding EndAddress}" Width="*" />
                    <DataGridTextColumn Header="Bytes" Binding="{Binding ByteCount}" Width="65" />
                </DataGrid.Columns>
            </DataGrid>
            <local:HexViewControl Grid.Column="2" x:Name="HexRowsView"
                                  ItemsSource="{Binding ViewModel.ImageView.Rows}"
                                  ShowAscii="{Binding ViewModel.ImageView.ShowAscii}"
                                  AddressRangeSelected="HexView_AddressRangeSelected" />
        </Grid>
    </DockPanel>
</Window>
