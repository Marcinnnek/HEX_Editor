<Window x:Class="HexEditor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HexEditor.UI"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="{Binding ViewModel.WindowTitle}" Height="620" Width="980" MinHeight="420" MinWidth="620"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SegmentListStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="12">
        <StackPanel x:Name="MainCommandBar" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Menu VerticalAlignment="Center">
            <ui:MenuItem Header="_File">
                <ui:MenuItem x:Name="OpenMenuItem" Header="Open..." Click="OpenImage_Click" IsEnabled="{Binding ViewModel.CanStartOpenCompareOrMerge}" InputGestureText="Ctrl+O" />
                <Separator />
                <ui:MenuItem x:Name="SaveMenuItem" Header="Save" Click="Save_Click" IsEnabled="{Binding ViewModel.ActiveCanSave}" InputGestureText="Ctrl+S" />
                <ui:MenuItem Header="Save As..." Click="SaveAs_Click" IsEnabled="{Binding ViewModel.ActiveCanSaveAs}" InputGestureText="Ctrl+Shift+S" />
                <ui:MenuItem Header="Close Image" Click="CloseImage_Click" IsEnabled="{Binding ViewModel.ActiveCanCloseImage}" InputGestureText="Ctrl+W" />
                <ui:MenuItem x:Name="CompareMenuItem" Header="Compare images..." Click="CompareImages_Click" IsEnabled="{Binding ViewModel.CanStartOpenCompareOrMerge}" />
                <ui:MenuItem x:Name="MergeMenuItem" Header="Merge images..." Click="MergeImages_Click" IsEnabled="{Binding ViewModel.CanStartOpenCompareOrMerge}" />
                <Separator />
                <ui:MenuItem Header="Export..." Click="ExportImage_Click" IsEnabled="{Binding ViewModel.ActiveHasImage}" />
            </ui:MenuItem>
            <ui:MenuItem x:Name="EditMenuItem" Header="_Edit" IsEnabled="{Binding ViewModel.CanEdit}">
                <ui:MenuItem Header="Undo" Click="Undo_Click" IsEnabled="{Binding ViewModel.ActiveCanUndo}" InputGestureText="Ctrl+Z" />
                <ui:MenuItem Header="Redo" Click="Redo_Click" IsEnabled="{Binding ViewModel.ActiveCanRedo}" InputGestureText="Ctrl+Y" />
                <Separator />
                <ui:MenuItem Header="Edit / Insert" Click="EditInsert_Click" />
                <ui:MenuItem Header="Fill range" Click="Fill_Click" />
                <ui:MenuItem Header="Copy range" Click="Copy_Click" IsEnabled="{Binding ViewModel.ActiveHasSelection}" />
                <ui:MenuItem Header="Cut range" Click="Cut_Click" IsEnabled="{Binding ViewModel.ActiveHasSelection}" />
                <ui:MenuItem Header="Paste at start" Click="Paste_Click" IsEnabled="{Binding ViewModel.ActiveCanPaste}" />
                <ui:MenuItem Header="Delete range" Click="Delete_Click" IsEnabled="{Binding ViewModel.ActiveHasSelection}" />
            </ui:MenuItem>
            <ui:MenuItem Header="_View">
                <ui:MenuItem Header="8 bytes per row" Click="RowWidth8_Click" />
                <ui:MenuItem Header="16 bytes per row" Click="RowWidth16_Click" />
                <ui:MenuItem Header="32 bytes per row" Click="RowWidth32_Click" />
                <Separator />
                <ui:MenuItem Header="Show ASCII" IsCheckable="True" IsChecked="{Binding ViewModel.ActiveShowAscii, Mode=TwoWay}" />
                <ui:MenuItem Header="Go to address" Click="GoToAddressDialog_Click" InputGestureText="Ctrl+G" />
                <ui:MenuItem Header="Find bytes..." Click="FindBytes_Click" InputGestureText="Ctrl+F" />
                <ui:MenuItem Header="Select range" Click="SelectRange_Click" IsEnabled="{Binding ViewModel.ActiveHasImage}" />
            </ui:MenuItem>
            <ui:MenuItem Header="_Tools" IsEnabled="{Binding ViewModel.CanEdit}">
                <ui:MenuItem Header="Checksum / Calculate..." Click="CalculateChecksum_Click" />
                <ui:MenuItem Header="Relocate selected segment" Click="RelocateSegment_Click" IsEnabled="{Binding ViewModel.ActiveCanRelocate}" />
                <ui:MenuItem Header="Remap bank addresses..." Click="RemapBanks_Click" IsEnabled="{Binding ViewModel.ActiveHasImage}" />
            </ui:MenuItem>
            <ui:MenuItem Header="_Preferences..." Click="Preferences_Click" />
            </Menu>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,8,0">
                <TextBlock Text="Bytes per row" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="RowWidthBox"
                          Width="85" MinHeight="30" Margin="0,0,8,0" VerticalAlignment="Center"
                          IsEditable="True" IsReadOnly="False" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                          Style="{StaticResource {x:Type ComboBox}}" ToolTip="Bytes per row"
                          ItemsSource="{Binding ViewModel.RowWidths}"
                          Text="{Binding ViewModel.ActiveBytesPerRow, Mode=OneWay}"
                          SelectionChanged="RowWidthBox_SelectionChanged"
                          PreviewTextInput="RowWidthBox_PreviewTextInput"
                          PreviewKeyDown="RowWidthBox_PreviewKeyDown"
                          LostKeyboardFocus="RowWidthBox_LostKeyboardFocus"
                          DataObject.Pasting="RowWidthBox_Pasting" />
                <CheckBox x:Name="AsciiCheckBox" Content="ASCII" ToolTip="Show ASCII"
                          IsChecked="{Binding ViewModel.ActiveShowAscii, UpdateSourceTrigger=PropertyChanged}"
                          VerticalAlignment="Center" Padding="4,0" />
            </StackPanel>
        </StackPanel>
        <Border DockPanel.Dock="Top" x:Name="FileOperationPanel" Visibility="Collapsed" BorderBrush="{DynamicResource HexBorderBrush}" BorderThickness="1" Padding="6" Margin="0,0,0,6">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="Cancel" Padding="10,3" Click="CancelFileOperation_Click" />
                    <StackPanel>
                        <TextBlock x:Name="FileOperationText" Text="Working..." Margin="0,0,0,3" />
                        <ProgressBar x:Name="FileOperationProgress" Height="8" IsIndeterminate="True" />
                    </StackPanel>
                </DockPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock>
                <Run Text="Address: " /><Run Text="{Binding ViewModel.EditorStatus.CurrentAddressText, Mode=OneWay}" />
                <Run Text="    Selection: " /><Run Text="{Binding ViewModel.EditorStatus.SelectionLength, Mode=OneWay}" /><Run Text=" byte(s)" />
                <Run Text="    Format: " /><Run Text="{Binding ViewModel.EditorStatus.ImageFormatText, Mode=OneWay}" />
                <Run Text="    State: " /><Run Text="{Binding ViewModel.EditorStatus.ModifiedStateText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Margin="0,3,0,0" Text="{Binding ViewModel.StatusMessage}" />
        </StackPanel>
        <TabControl x:Name="WorkspaceTabs" SelectionChanged="WorkspaceTabs_SelectionChanged">
            <TabItem Header="Editor">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <GroupBox Grid.Row="0" Header="{Binding ViewModel.EditorBlockListHeader}" Margin="0,0,0,8" MaxHeight="130">
                        <GroupBox.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="6,4,4,6" />
                            </DataTemplate>
                        </GroupBox.HeaderTemplate>
                        <ListBox x:Name="SegmentsGrid" ItemsSource="{Binding ViewModel.Segments}"
                                 HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                 SelectionMode="Extended" SelectionChanged="SegmentsGrid_SelectionChanged"
                                 MouseDoubleClick="SegmentsGrid_MouseDoubleClick"
                                 MaxHeight="104" MinHeight="40"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="False"
                                 ItemContainerStyle="{StaticResource MemoryBlockListItemContainerStyle}"
                                 ItemTemplate="{StaticResource MemoryBlockListItemTemplate}">
                        </ListBox>
                    </GroupBox>
                    <local:HexViewControl Grid.Row="1" x:Name="HexRowsView"
                                          ItemsSource="{Binding ViewModel.ImageView.Rows}"
                                          BytesPerRow="{Binding ViewModel.ImageView.BytesPerRow}"
                                          UseWindowedScrolling="True"
                                          ShowAscii="{Binding ViewModel.ImageView.ShowAscii}"
                                          AddressRangeSelected="HexView_AddressRangeSelected">
                        <local:HexViewControl.ContextMenu>
                            <ContextMenu Style="{StaticResource HexContextMenuStyle}">
                                <MenuItem Header="Select Range..." Click="SelectRange_Click" Style="{StaticResource HexContextMenuItemStyle}" />
                                <Separator Style="{StaticResource HexContextMenuSeparatorStyle}" />
                                <MenuItem Header="Edit / Insert..." Click="EditInsert_Click" Style="{StaticResource HexContextMenuItemStyle}" />
                                <MenuItem Header="Fill Range..." Click="Fill_Click" Style="{StaticResource HexContextMenuItemStyle}" />
                                <MenuItem Header="Fill with Pattern..." Click="Fill_Click" Style="{StaticResource HexContextMenuItemStyle}" />
                                <MenuItem Header="Paste clipboard bytes" Click="PasteClipboardBytes_Click" Style="{StaticResource HexContextMenuItemStyle}" />
                                <MenuItem Header="Delete selected bytes" Click="DeleteSelectedBytes_Click" Style="{StaticResource HexContextMenuItemStyle}" />
                            </ContextMenu>
                        </local:HexViewControl.ContextMenu>
                    </local:HexViewControl>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
