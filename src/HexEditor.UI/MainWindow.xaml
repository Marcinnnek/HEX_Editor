<ui:FluentWindow x:Class="HexEditor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HexEditor.UI"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="HEX Editor" Height="620" Width="980" MinHeight="420" MinWidth="640">
    <DockPanel Margin="12">
        <Menu DockPanel.Dock="Top" Margin="0,0,0,8">
            <ui:MenuItem Header="_File">
                <ui:MenuItem Header="Open HEX / S-Record..." Click="OpenImage_Click" />
                <Separator />
                <ui:MenuItem Header="Save" Click="Save_Click" />
                <ui:MenuItem Header="Save As..." Click="SaveAs_Click" />
                <ui:MenuItem Header="Close Image" Click="CloseImage_Click" />
                <Separator />
                <ui:MenuItem Header="Export Image..." Click="ExportImage_Click" />
                <ui:MenuItem Header="Export Selected Segments..." Click="ExportSegments_Click" />
                <ui:MenuItem Header="Export Address Range..." Click="ExportRange_Click" />
            </ui:MenuItem>
            <ui:MenuItem Header="_Edit">
                <ui:MenuItem Header="Undo" Click="Undo_Click" IsEnabled="{Binding ViewModel.ActiveCanUndo}" />
                <ui:MenuItem Header="Redo" Click="Redo_Click" IsEnabled="{Binding ViewModel.ActiveCanRedo}" />
                <Separator />
                <ui:MenuItem Header="Edit / Insert" Click="EditInsert_Click" />
                <ui:MenuItem Header="Fill range" Click="Fill_Click" />
                <ui:MenuItem Header="Copy range" Click="Copy_Click" />
                <ui:MenuItem Header="Cut range" Click="Cut_Click" />
                <ui:MenuItem Header="Paste at start" Click="Paste_Click" />
                <ui:MenuItem Header="Delete range" Click="Delete_Click" />
            </ui:MenuItem>
            <ui:MenuItem Header="_View">
                <ui:MenuItem Header="8 bytes per row" Click="RowWidth8_Click" />
                <ui:MenuItem Header="16 bytes per row" Click="RowWidth16_Click" />
                <ui:MenuItem Header="32 bytes per row" Click="RowWidth32_Click" />
                <Separator />
                <ui:MenuItem Header="Show ASCII" IsCheckable="True" IsChecked="{Binding ViewModel.ActiveShowAscii, Mode=TwoWay}" />
                <ui:MenuItem Header="Go to address" Click="GoToAddress_Click" />
                <ui:MenuItem Header="Select range" Click="SelectRange_Click" />
            </ui:MenuItem>
            <ui:MenuItem Header="_Compare">
                <ui:MenuItem Header="Compare images..." Click="CompareImages_Click" />
            </ui:MenuItem>
            <ui:MenuItem Header="_Merge">
                <ui:MenuItem Header="Merge images..." Click="MergeImages_Click" />
            </ui:MenuItem>
            <ui:MenuItem Header="_Tools">
                <ui:MenuItem Header="Checksum / Calculate..." Click="CalculateChecksum_Click" />
                <ui:MenuItem Header="Relocate selected segment" Click="RelocateSegment_Click" />
            </ui:MenuItem>
            <ui:MenuItem Header="_Appearance">
                <ui:MenuItem x:Name="AutomaticAppearanceItem" Header="Follow Windows" IsCheckable="True" Click="AutomaticAppearance_Click" />
                <ui:MenuItem x:Name="LightAppearanceItem" Header="Light" IsCheckable="True" Click="LightAppearance_Click" />
                <ui:MenuItem x:Name="DarkAppearanceItem" Header="Dark" IsCheckable="True" Click="DarkAppearance_Click" />
            </ui:MenuItem>
            <ui:MenuItem Header="E_xport">
                <ui:MenuItem Header="Export Image..." Click="ExportImage_Click" />
                <ui:MenuItem Header="Export Selected Segments..." Click="ExportSegments_Click" />
                <ui:MenuItem Header="Export Address Range..." Click="ExportRange_Click" />
            </ui:MenuItem>
        </Menu>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Border x:Name="FileOperationPanel" Visibility="Collapsed" BorderBrush="#FF8A8A8A" BorderThickness="1" Padding="6" Margin="0,0,0,6">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="Cancel" Padding="10,3" Click="CancelFileOperation_Click" />
                    <StackPanel>
                        <TextBlock x:Name="FileOperationText" Text="Working..." Margin="0,0,0,3" />
                        <ProgressBar x:Name="FileOperationProgress" Height="8" IsIndeterminate="True" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
                <ui:Button Content="Open HEX / S-Record" Padding="10,5" Click="OpenImage_Click" Margin="0,0,6,0" />
                <ui:Button Content="Compare images" Padding="10,5" Click="CompareImages_Click" Margin="0,0,6,0" />
                <ui:Button Content="Merge images" Padding="10,5" Click="MergeImages_Click" Margin="0,0,6,0" />
                <ui:Button Content="Save" Padding="10,5" Click="Save_Click" Margin="0,0,6,0" />
                <ui:Button Content="Save As" Padding="10,5" Click="SaveAs_Click" Margin="0,0,6,0" />
                <ui:Button Content="Close Image" Padding="10,5" Click="CloseImage_Click" Margin="0,0,6,0" />
                <ui:Button Content="Undo" Padding="10,5" Click="Undo_Click" Margin="0,0,6,0" IsEnabled="{Binding ViewModel.ActiveCanUndo}" />
                <ui:Button Content="Redo" Padding="10,5" Click="Redo_Click" Margin="0,0,12,0" IsEnabled="{Binding ViewModel.ActiveCanRedo}" />
                <TextBlock Text="Bytes per row" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="65" ItemsSource="{Binding ViewModel.RowWidths}"
                          SelectedItem="{Binding ViewModel.ActiveBytesPerRow, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="Show ASCII" IsChecked="{Binding ViewModel.ActiveShowAscii, UpdateSourceTrigger=PropertyChanged}"
                          VerticalAlignment="Center" Margin="12,0,12,0" />
                <TextBlock Text="Go to" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ui:TextBox x:Name="AddressInput" Width="90" VerticalContentAlignment="Center" />
                <ui:Button Content="Go" Padding="8,4" Margin="4,0,0,0" Click="GoToAddress_Click" />
                <ui:Button Content="Relocate selected segment" Padding="8,4" Margin="8,0,0,0" Click="RelocateSegment_Click" />
            </WrapPanel>
            <WrapPanel VerticalAlignment="Center">
                <ui:Button Content="Copy" Click="Copy_Click" Padding="8,4" Margin="0,0,4,0" />
                <ui:Button Content="Cut" Click="Cut_Click" Padding="8,4" Margin="0,0,4,0" />
                <ui:Button Content="Paste at Start" Click="Paste_Click" Padding="8,4" Margin="0,0,4,0" />
                <ui:Button Content="Delete" Click="Delete_Click" Padding="8,4" />
            </WrapPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock>
                <Run Text="Address: " /><Run Text="{Binding ViewModel.EditorStatus.CurrentAddressText, Mode=OneWay}" />
                <Run Text="    Selection: " /><Run Text="{Binding ViewModel.EditorStatus.SelectionLength, Mode=OneWay}" /><Run Text=" byte(s)" />
                <Run Text="    Format: " /><Run Text="{Binding ViewModel.EditorStatus.ImageFormatText, Mode=OneWay}" />
                <Run Text="    State: " /><Run Text="{Binding ViewModel.EditorStatus.ModifiedStateText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Margin="0,3,0,0" Text="{Binding ViewModel.StatusMessage}" />
        </StackPanel>
        <TabControl x:Name="WorkspaceTabs" SelectionChanged="WorkspaceTabs_SelectionChanged">
            <TabItem Header="Editor">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:DataGrid Grid.Row="0" x:Name="SegmentsGrid" ItemsSource="{Binding ViewModel.Segments}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" SelectionMode="Extended" SelectionChanged="SegmentsGrid_SelectionChanged"
                              MaxHeight="150" MinHeight="72" VerticalScrollBarVisibility="Auto">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn Header="Start Address" Binding="{Binding StartAddress}" Width="*" />
                            <DataGridTextColumn Header="End Address" Binding="{Binding EndAddress}" Width="*" />
                            <DataGridTextColumn Header="Bytes" Binding="{Binding ByteCount}" Width="65" />
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <local:HexViewControl Grid.Row="2" x:Name="HexRowsView"
                                          ItemsSource="{Binding ViewModel.ImageView.Rows}"
                                          ShowAscii="{Binding ViewModel.ImageView.ShowAscii}"
                                          AddressRangeSelected="HexView_AddressRangeSelected">
                        <local:HexViewControl.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Select Range..." Click="SelectRange_Click" />
                                <Separator />
                                <MenuItem Header="Edit / Insert..." Click="EditInsert_Click" />
                                <MenuItem Header="Fill Range..." Click="Fill_Click" />
                            </ContextMenu>
                        </local:HexViewControl.ContextMenu>
                    </local:HexViewControl>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</ui:FluentWindow>
