<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="SegmentListTextBlockStyle" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Left" />
    </Style>
    <Style x:Key="SegmentListCellStyle" TargetType="DataGridCell">
        <Setter Property="Padding" Value="4,3" />
    </Style>
    <Style x:Key="MemoryBlockListItemContainerStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <DataTemplate x:Key="MemoryBlockListItemTemplate">
        <TextBlock Text="{Binding Description}" TextWrapping="NoWrap" MinWidth="680" />
    </DataTemplate>
</ResourceDictionary>
