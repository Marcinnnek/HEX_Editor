<ui:FluentWindow x:Class="HexEditor.UI.MergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Preview and merge images" Height="700" Width="900" MinHeight="540" MinWidth="760"
        WindowStartupLocation="CenterOwner">
    <Grid>
    <DockPanel x:Name="MergePanel" Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Content="Preview result" Padding="12,6" Margin="0,0,8,0" Click="PreviewResult_Click" />
            <ui:Button x:Name="ApplyButton" Content="Apply merge" Padding="12,6" Margin="0,0,8,0" IsDefault="True" IsEnabled="False" Click="Apply_Click" />
            <ui:Button Content="Cancel" Padding="12,6" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Choose the merge direction and review every occupied overlap before applying." TextWrapping="Wrap" Margin="0,0,0,10" />
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="Direction" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="DirectionBox" Width="300" SelectionChanged="Direction_SelectionChanged" />
                <TextBlock Text="Default overlap choice" VerticalAlignment="Center" Margin="18,0,6,0" />
                <ComboBox x:Name="DefaultChoiceBox" Width="230" SelectionChanged="Policy_SelectionChanged" />
            </WrapPanel>
            <TextBlock x:Name="DirectionSummary" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="OverlapSummary" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <GroupBox Header="Overlap summary">
                <ui:DataGrid ItemsSource="{Binding OverlapRows}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column" EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ui:DataGrid.Columns>
                        <DataGridTextColumn Header="Start" Binding="{Binding StartAddress}" Width="110" />
                        <DataGridTextColumn Header="End" Binding="{Binding EndAddress}" Width="110" />
                        <DataGridTextColumn Header="Overlapping bytes" Binding="{Binding TotalByteCount}" Width="140" />
                        <DataGridTextColumn Header="Identical" Binding="{Binding IdenticalByteCount}" Width="100" />
                        <DataGridTextColumn Header="Different" Binding="{Binding DifferentByteCount}" Width="100" />
                    </ui:DataGrid.Columns>
                </ui:DataGrid>
            </GroupBox>
            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" />
            <GroupBox Grid.Row="2" Header="Address-range overrides" Padding="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Override the default overlap choice for an inclusive hexadecimal address range." TextWrapping="Wrap" Margin="0,0,0,6" />
                        <WrapPanel Margin="0,0,0,6">
                            <TextBlock Text="Start" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ui:TextBox x:Name="OverrideStartBox" Width="95" Text="00000000" Margin="0,0,8,0" />
                            <TextBlock Text="End" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ui:TextBox x:Name="OverrideEndBox" Width="95" Text="00000000" Margin="0,0,8,0" />
                            <ComboBox x:Name="OverrideChoiceBox" Width="215" Margin="0,0,8,0" />
                            <ui:Button Content="Add override" Padding="8,3" Click="AddOverride_Click" />
                        </WrapPanel>
                    </StackPanel>
                    <ListBox x:Name="OverrideList" ItemsSource="{Binding OverrideRows}" DisplayMemberPath="Description" />
                    <ui:Button DockPanel.Dock="Bottom" Content="Remove selected override" HorizontalAlignment="Left" Padding="8,3" Margin="0,6,0,0" Click="RemoveOverride_Click" />
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
    <Grid x:Name="ComparisonPreviewPanel" Visibility="Collapsed">
        <DockPanel>
            <ui:Button DockPanel.Dock="Top" Content="Back to merge choices" HorizontalAlignment="Left" Padding="10,5" Margin="12,12,0,8" Click="ReturnToMerge_Click" />
            <ContentControl x:Name="ComparisonPreviewHost" />
        </DockPanel>
    </Grid>
    </Grid>
</ui:FluentWindow>
