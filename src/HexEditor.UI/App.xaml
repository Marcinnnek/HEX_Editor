<Application x:Class="HexEditor.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HexEditor.UI"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="SegmentListStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="{x:Type Window}">
                <Setter Property="Background" Value="{DynamicResource HexWindowBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
            </Style>
            <Style TargetType="{x:Type UserControl}">
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
            </Style>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource HexDisabledTextBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type Button}">
                <Setter Property="Background" Value="{DynamicResource HexRaisedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HexBorderBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource HexDisabledTextBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource HexFocusBrush}" /></Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="{DynamicResource HexSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HexBorderBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource HexSelectionBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource HexDisabledTextBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource HexFocusBrush}" /></Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type ComboBox}">
                <Setter Property="Background" Value="{DynamicResource HexSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HexBorderBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBox}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="26" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ComboBorder" Grid.ColumnSpan="2"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1" CornerRadius="3" />
                                <ContentPresenter x:Name="ContentSite" Grid.Column="0" IsHitTestVisible="False"
                                                  Margin="6,3,0,3" VerticalAlignment="Center"
                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}" />
                                <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Margin="6,2,0,2"
                                         VerticalContentAlignment="Center" Background="{TemplateBinding Background}"
                                         Foreground="{TemplateBinding Foreground}" BorderThickness="0"
                                         IsReadOnly="{TemplateBinding IsReadOnly}"
                                         Visibility="Hidden" />
                                <ToggleButton x:Name="DropDownToggle" Grid.ColumnSpan="2" Focusable="False" ClickMode="Release"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border Grid.Column="1" BorderBrush="{DynamicResource HexBorderBrush}"
                                        BorderThickness="1,0,0,0" Margin="0,4" IsHitTestVisible="False" />
                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="{DynamicResource HexTextBrush}" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" IsHitTestVisible="False" />
                                <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{DynamicResource HexSurfaceBrush}" BorderBrush="{DynamicResource HexBorderBrush}"
                                            BorderThickness="1" Padding="2">
                                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEditable" Value="True">
                                    <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="DropDownToggle" Property="Grid.Column" Value="1" />
                                    <Setter TargetName="DropDownToggle" Property="Grid.ColumnSpan" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource HexDisabledTextBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource HexFocusBrush}" /></Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type ComboBoxItem}">
                <Setter Property="Background" Value="{DynamicResource HexSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource HexSelectionBrush}" /></Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type CheckBox}">
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource HexDisabledTextBrush}" /></Trigger></Style.Triggers>
            </Style>
            <Style TargetType="{x:Type RadioButton}">
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource HexSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HexBorderBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource HexDisabledTextBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource HexFocusBrush}" /></Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type Slider}">
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource HexRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HexBorderBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource HexDisabledTextBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource HexFocusBrush}" /></Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type ListBox}">
                <Setter Property="Background" Value="{DynamicResource HexSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HexBorderBrush}" />
            </Style>
            <Style TargetType="{x:Type ListBoxItem}">
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource HexSelectionBrush}" /></Trigger></Style.Triggers>
            </Style>
            <Style TargetType="{x:Type Menu}">
                <Setter Property="Background" Value="{DynamicResource HexSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
            </Style>
            <Style TargetType="{x:Type ContextMenu}">
                <Setter Property="Background" Value="{DynamicResource HexSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
            </Style>
            <Style TargetType="{x:Type MenuItem}">
                <Setter Property="Background" Value="{DynamicResource HexSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource HexSelectionBrush}" /></Trigger></Style.Triggers>
            </Style>
            <Style TargetType="{x:Type ToolBarTray}"><Setter Property="Background" Value="{DynamicResource HexWindowBrush}" /></Style>
            <Style TargetType="{x:Type ToolBar}">
                <Setter Property="Background" Value="{DynamicResource HexWindowBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToolBar}">
                            <Border Background="{DynamicResource HexWindowBrush}" Padding="0,2">
                                <ToolBarPanel IsItemsHost="True" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type TabControl}">
                <Setter Property="Background" Value="{DynamicResource HexWindowBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HexBorderBrush}" />
            </Style>
            <Style TargetType="{x:Type TabItem}">
                <Setter Property="Background" Value="{DynamicResource HexRaisedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HexBorderBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Border x:Name="TabBorder" Background="{DynamicResource HexRaisedBrush}"
                                    BorderBrush="{DynamicResource HexBorderBrush}" BorderThickness="1" Padding="12,5">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource HexSurfaceBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type GroupBox}">
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HexBorderBrush}" />
            </Style>
            <Style TargetType="{x:Type local:HexByteRowControl}">
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
