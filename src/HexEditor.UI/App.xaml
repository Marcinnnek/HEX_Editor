<Application x:Class="HexEditor.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HexEditor.UI"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="{x:Type Window}">
                <Setter Property="Background" Value="{DynamicResource HexWindowBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
            </Style>
            <Style TargetType="{x:Type UserControl}">
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
            </Style>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource HexDisabledTextBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SegmentListTextBlockStyle" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Left" />
            </Style>
            <Style x:Key="SegmentListCellStyle" TargetType="{x:Type DataGridCell}">
                <Setter Property="Padding" Value="4,3" />
            </Style>
            <Style TargetType="{x:Type Button}">
                <Setter Property="Background" Value="{DynamicResource HexRaisedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HexBorderBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource HexDisabledTextBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource HexFocusBrush}" /></Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="{DynamicResource HexSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HexBorderBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource HexSelectionBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource HexDisabledTextBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource HexFocusBrush}" /></Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type ComboBox}">
                <Setter Property="Background" Value="{DynamicResource HexSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HexBorderBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBox}">
                            <Grid>
                                <ToggleButton Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border Background="{DynamicResource HexSurfaceBrush}" BorderBrush="{DynamicResource HexBorderBrush}"
                                                    BorderThickness="1" CornerRadius="3" Padding="6,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <ContentPresenter IsHitTestVisible="False" VerticalAlignment="Center"
                                                                      Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" />
                                                    <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource HexTextBrush}"
                                                          VerticalAlignment="Center" Margin="8,0,1,0" />
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                       IsOpen="{TemplateBinding IsDropDownOpen}">
                                    <Border Background="{DynamicResource HexSurfaceBrush}" BorderBrush="{DynamicResource HexBorderBrush}"
                                            BorderThickness="1" Padding="2">
                                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource HexDisabledTextBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource HexFocusBrush}" /></Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type ComboBoxItem}">
                <Setter Property="Background" Value="{DynamicResource HexSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource HexSelectionBrush}" /></Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type CheckBox}">
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource HexDisabledTextBrush}" /></Trigger></Style.Triggers>
            </Style>
            <Style TargetType="{x:Type RadioButton}">
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource HexSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HexBorderBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource HexDisabledTextBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource HexFocusBrush}" /></Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type Slider}">
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource HexRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HexBorderBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource HexDisabledTextBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource HexFocusBrush}" /></Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type ListBox}">
                <Setter Property="Background" Value="{DynamicResource HexSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HexBorderBrush}" />
            </Style>
            <Style TargetType="{x:Type ListBoxItem}">
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource HexSelectionBrush}" /></Trigger></Style.Triggers>
            </Style>
            <Style TargetType="{x:Type Menu}">
                <Setter Property="Background" Value="{DynamicResource HexSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
            </Style>
            <Style TargetType="{x:Type ContextMenu}">
                <Setter Property="Background" Value="{DynamicResource HexSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
            </Style>
            <Style TargetType="{x:Type MenuItem}">
                <Setter Property="Background" Value="{DynamicResource HexSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource HexSelectionBrush}" /></Trigger></Style.Triggers>
            </Style>
            <Style TargetType="{x:Type ToolBarTray}"><Setter Property="Background" Value="{DynamicResource HexWindowBrush}" /></Style>
            <Style TargetType="{x:Type ToolBar}">
                <Setter Property="Background" Value="{DynamicResource HexWindowBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToolBar}">
                            <Border Background="{DynamicResource HexWindowBrush}" Padding="0,2">
                                <ToolBarPanel IsItemsHost="True" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type TabControl}">
                <Setter Property="Background" Value="{DynamicResource HexWindowBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HexBorderBrush}" />
            </Style>
            <Style TargetType="{x:Type TabItem}">
                <Setter Property="Background" Value="{DynamicResource HexRaisedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HexBorderBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Border x:Name="TabBorder" Background="{DynamicResource HexRaisedBrush}"
                                    BorderBrush="{DynamicResource HexBorderBrush}" BorderThickness="1" Padding="12,5">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource HexSurfaceBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type GroupBox}">
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HexBorderBrush}" />
            </Style>
            <Style TargetType="{x:Type local:HexByteRowControl}">
                <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
