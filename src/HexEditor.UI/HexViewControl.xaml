<UserControl x:Class="HexEditor.UI.HexViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HexEditor.UI"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
      <Style x:Key="WindowedRowSelectionStyle" TargetType="Grid">
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsSelected}" Value="True">
            <Setter Property="Background" Value="{DynamicResource HexSelectionBrush}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ScrollBarLineButtonStyle" TargetType="RepeatButton">
        <Setter Property="Background" Value="{DynamicResource HexRaisedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource HexTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HexBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RepeatButton">
              <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HexSelectionBrush}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HexFocusBrush}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </UserControl.Resources>
    <Grid x:Name="Root" Loaded="Control_Loaded" Unloaded="Control_Unloaded">
      <Grid x:Name="WindowedView" Visibility="Collapsed" SizeChanged="WindowedView_SizeChanged" PreviewMouseLeftButtonDown="AddressRow_PreviewMouseLeftButtonDown">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="WindowedScroll" Grid.RowSpan="2" Grid.Column="0"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      FontFamily="{Binding FontFamily, ElementName=HexGrid}"
                      FontSize="{Binding FontSize, ElementName=HexGrid}"
                      FontStyle="{Binding FontStyle, ElementName=HexGrid}"
                      FontWeight="{Binding FontWeight, ElementName=HexGrid}"
                      FontStretch="{Binding FontStretch, ElementName=HexGrid}"
                      PreviewMouseWheel="WindowedScroll_PreviewMouseWheel">
          <StackPanel>
            <Grid Margin="0,4,0,4" TextElement.FontWeight="Bold">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding AddressColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type local:HexViewControl}}}"/><ColumnDefinition Width="{Binding HexDataColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type local:HexViewControl}}}"/>
                <ColumnDefinition x:Name="WindowedHeaderAsciiColumn" Width="Auto">
                  <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                      <Style.Triggers><DataTrigger Binding="{Binding ShowAscii, RelativeSource={RelativeSource AncestorType={x:Type local:HexViewControl}}}" Value="False">
                        <Setter Property="Width" Value="0"/><Setter Property="MinWidth" Value="0"/>
                      </DataTrigger></Style.Triggers>
                    </Style>
                  </ColumnDefinition.Style>
                </ColumnDefinition>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Address" TextAlignment="Center" HorizontalAlignment="Stretch"/>
              <TextBlock Grid.Column="1" Text="HEX Data" Margin="6,0"/>
              <TextBlock x:Name="WindowedAsciiHeader" Grid.Column="2" Text="ASCII" Margin="6,0,0,0"/>
            </Grid>
            <ItemsControl x:Name="WindowedRows" ItemsSource="{Binding WindowRows, RelativeSource={RelativeSource AncestorType=UserControl}}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                  <Setter Property="Margin" Value="{Binding RowGap, RelativeSource={RelativeSource AncestorType={x:Type local:HexViewControl}}}"/>
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Style="{StaticResource WindowedRowSelectionStyle}">
                    <Grid.Resources>
                        <Style TargetType="local:HexRowAddressControl">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="local:HexByteRowControl">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="{Binding AddressColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type local:HexViewControl}}}"/><ColumnDefinition Width="{Binding HexDataColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type local:HexViewControl}}}"/>
                      <ColumnDefinition x:Name="WindowedRowAsciiColumn" Width="Auto">
                        <ColumnDefinition.Style>
                          <Style TargetType="ColumnDefinition">
                            <Style.Triggers><DataTrigger Binding="{Binding ShowAscii, RelativeSource={RelativeSource AncestorType={x:Type local:HexViewControl}}}" Value="False">
                              <Setter Property="Width" Value="0"/><Setter Property="MinWidth" Value="0"/>
                            </DataTrigger></Style.Triggers>
                          </Style>
                        </ColumnDefinition.Style>
                      </ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <local:HexRowAddressControl Grid.Column="0" Row="{Binding Row}" MouseLeftButtonDown="AddressCell_Click"/>
                    <local:HexByteRowControl Grid.Column="1" Width="{Binding HexDataContentWidth, RelativeSource={RelativeSource AncestorType={x:Type local:HexViewControl}}}" Margin="6,0" Row="{Binding Row}" SelectionStart="{Binding SelectionStart, RelativeSource={RelativeSource AncestorType={x:Type local:HexViewControl}}}" SelectionEnd="{Binding SelectionEnd, RelativeSource={RelativeSource AncestorType={x:Type local:HexViewControl}}}" MouseLeftButtonDown="ByteCell_Click"/>
                    <local:HexByteRowControl x:Name="WindowedAscii" Grid.Column="2" Row="{Binding Row}" IsAscii="True" RowCapacity="{Binding BytesPerRow, RelativeSource={RelativeSource AncestorType={x:Type local:HexViewControl}}}" SelectionStart="{Binding SelectionStart, RelativeSource={RelativeSource AncestorType={x:Type local:HexViewControl}}}" SelectionEnd="{Binding SelectionEnd, RelativeSource={RelativeSource AncestorType={x:Type local:HexViewControl}}}" MouseLeftButtonDown="ByteCell_Click">
                      <local:HexByteRowControl.Style>
                        <Style TargetType="local:HexByteRowControl">
                          <Setter Property="Visibility" Value="Visible"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowAscii, RelativeSource={RelativeSource AncestorType={x:Type local:HexViewControl}}}" Value="False">
                              <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </local:HexByteRowControl.Style>
                    </local:HexByteRowControl>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <ScrollBar x:Name="RowThumb" Grid.Column="1" Orientation="Vertical"
                   Minimum="0" Maximum="0" ViewportSize="1" SmallChange="3" LargeChange="10"
                   ValueChanged="RowThumb_ValueChanged">
          <ScrollBar.Template>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="{DynamicResource HexSurfaceBrush}">
                <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="18"/></Grid.RowDefinitions>
                <RepeatButton x:Name="PART_LineUpButton" Grid.Row="0" Height="18"
                              Style="{StaticResource ScrollBarLineButtonStyle}"
                              Command="{x:Static ScrollBar.LineUpCommand}"
                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                  <Path Data="M 0,4 L 4,0 L 8,4 Z" Fill="{DynamicResource HexTextBrush}" Width="8" Height="4"/>
                </RepeatButton>
                <Track x:Name="PART_Track" Grid.Row="1" Orientation="Vertical" IsDirectionReversed="True">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollBarPageButtonStyle}"/>
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb MinHeight="15" MinWidth="16" Background="#777">
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border Margin="2,1" Background="{TemplateBinding Background}" CornerRadius="8"
                                  SnapsToDevicePixels="True"/>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollBarPageButtonStyle}"/>
                  </Track.IncreaseRepeatButton>
                </Track>
                <RepeatButton x:Name="PART_LineDownButton" Grid.Row="2" Height="18"
                              Style="{StaticResource ScrollBarLineButtonStyle}"
                              Command="{x:Static ScrollBar.LineDownCommand}"
                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                  <Path Data="M 0,0 L 4,4 L 8,0 Z" Fill="{DynamicResource HexTextBrush}" Width="8" Height="4"/>
                </RepeatButton>
              </Grid>
            </ControlTemplate>
          </ScrollBar.Template>
        </ScrollBar>
      </Grid>
      <ui:DataGrid x:Name="HexGrid" PreviewMouseLeftButtonDown="AddressRow_PreviewMouseLeftButtonDown"
              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
              CanUserResizeColumns="False"
              SelectionUnit="Cell" SelectionMode="Extended"
              EnableRowVirtualization="True" EnableColumnVirtualization="True"
              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
              ScrollViewer.CanContentScroll="True" FontFamily="Consolas">
        <ui:DataGrid.ColumnHeaderStyle>
          <Style TargetType="DataGridColumnHeader"
                BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
              <Setter Property="Padding" Value="0,4,0,4"/>
              <Setter Property="VerticalContentAlignment" Value="Center"/>
              <Setter Property="FontWeight" Value="Bold"/>
          </Style>
        </ui:DataGrid.ColumnHeaderStyle>
        <ui:DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
                <Setter Property="Margin" Value="{Binding RowGap, RelativeSource={RelativeSource AncestorType={x:Type local:HexViewControl}}}" />
            </Style>
        </ui:DataGrid.RowStyle>
        <ui:DataGrid.CellStyle>
            <Style TargetType="DataGridCell">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
        </ui:DataGrid.CellStyle>
        <ui:DataGrid.Columns>
<DataGridTemplateColumn Header="Address"
                        Width="100"
                        CanUserResize="False">

    <DataGridTemplateColumn.HeaderStyle>
        <Style TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,4,0,4"/>
        </Style>
    </DataGridTemplateColumn.HeaderStyle>

    <DataGridTemplateColumn.HeaderTemplate>
        <DataTemplate>
            <TextBlock Text="Address"
                       TextAlignment="Center"/>
        </DataTemplate>
    </DataGridTemplateColumn.HeaderTemplate>
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Grid>
                            <TextBlock Text="{Binding Address}" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GapDescription}" ToolTip="{Binding GapDescription}" FontStyle="Italic" TextAlignment="Left" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" Margin="6,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGapMarker}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn x:Name="HexDataColumn" Header="HEX Data" Width="Auto">
                <DataGridTemplateColumn.HeaderTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" Margin="6,0,0,0"/></DataTemplate>
                </DataGridTemplateColumn.HeaderTemplate>
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <local:HexByteRowControl Width="{Binding HexDataContentWidth, RelativeSource={RelativeSource AncestorType={x:Type local:HexViewControl}}}" Margin="6,0" Row="{Binding}" SelectionStart="{Binding SelectionStart, RelativeSource={RelativeSource AncestorType={x:Type local:HexViewControl}}}" SelectionEnd="{Binding SelectionEnd, RelativeSource={RelativeSource AncestorType={x:Type local:HexViewControl}}}" MouseLeftButtonDown="ByteCell_Click" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn x:Name="AsciiColumn" Header="ASCII" Width="192">
                <DataGridTemplateColumn.HeaderStyle>
                    <Style TargetType="DataGridColumnHeader"
                               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="Padding" Value="6,4,0,4" />
                    </Style>
                </DataGridTemplateColumn.HeaderStyle>
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <local:HexByteRowControl Row="{Binding}" IsAscii="True" RowCapacity="{Binding BytesPerRow, RelativeSource={RelativeSource AncestorType={x:Type local:HexViewControl}}}" SelectionStart="{Binding SelectionStart, RelativeSource={RelativeSource AncestorType={x:Type local:HexViewControl}}}" SelectionEnd="{Binding SelectionEnd, RelativeSource={RelativeSource AncestorType={x:Type local:HexViewControl}}}" MouseLeftButtonDown="ByteCell_Click" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </ui:DataGrid.Columns>
      </ui:DataGrid>
    </Grid>
</UserControl>
