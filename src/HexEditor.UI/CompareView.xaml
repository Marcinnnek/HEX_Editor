<UserControl x:Class="HexEditor.UI.CompareView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HexEditor.UI"
        xmlns:compare="clr-namespace:HexEditor.Compare;assembly=HexEditor.Compare"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SegmentListStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10,7"
                BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                CornerRadius="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <TextBlock Text="{Binding ViewModel.ComparisonStatus}" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10" VerticalAlignment="Center">
            <ComboBox x:Name="ViewModeBox" Width="150" Height="{Binding ElementName=RangeStartBox, Path=ActualHeight}"
                      FontSize="15" VerticalContentAlignment="Center"
                      ItemsSource="{Binding ViewModes}" SelectedItem="{Binding ViewModel.ViewMode}" />
            <StackPanel x:Name="RangeControls" Orientation="Horizontal" Margin="0,0,12,0" ToolTipService.ShowOnDisabled="True">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="IsEnabled" Value="False" />
                        <Setter Property="ToolTip" Value="Only available in Address Range mode." />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.ViewMode}" Value="{x:Static compare:CompareViewMode.AddressRange}">
                                <Setter Property="IsEnabled" Value="True" />
                                <Setter Property="ToolTip" Value="{x:Null}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Start" FontSize="15" VerticalAlignment="Center" Margin="10,0,4,0" />
                <ui:TextBox x:Name="RangeStartBox" Text="00000000" local:HexAddressInput.Apply="True" />
                <TextBlock Text="End" FontSize="15" VerticalAlignment="Center" Margin="8,0,4,0" />
                <ui:TextBox x:Name="RangeEndBox" Text="FFFFFFFF" local:HexAddressInput.Apply="True" />
                <ui:Button x:Name="ApplyRangeButton" Content="Apply range" Height="{Binding ElementName=RangeEndBox, Path=ActualHeight}"
                           FontSize="15" VerticalContentAlignment="Center" Margin="5,0" Padding="8,3" Click="ApplyRange_Click" />
            </StackPanel>
            <ui:TextBox x:Name="AddressBox" local:HexAddressInput.Apply="True" />
            <ui:Button x:Name="GoButton" Content="Go" Height="{Binding ElementName=AddressBox, Path=ActualHeight}"
                       FontSize="15" VerticalContentAlignment="Center" Margin="4,0" Padding="8,3" Click="Go_Click" />
            <ui:Button x:Name="PreviousDifferenceButton" Content="Previous difference" Height="{Binding ElementName=AddressBox, Path=ActualHeight}"
                       FontSize="15" VerticalContentAlignment="Center" Margin="10,0,3,0" Padding="8,3" Click="PreviousDifference_Click" />
            <ui:Button x:Name="NextDifferenceButton" Content="Next difference" Height="{Binding ElementName=AddressBox, Path=ActualHeight}"
                       FontSize="15" VerticalContentAlignment="Center" Padding="8,3" Click="NextDifference_Click" />
        </WrapPanel>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <GroupBox Grid.Row="0" Grid.Column="0" Margin="0,0,0,8" Header="{Binding Workspace.NameA}"
                          HeaderTemplate="{StaticResource MemoryBlockGroupHeaderTemplate}" MaxHeight="130">
                <ListBox x:Name="FileABlocks" ItemsSource="{Binding Workspace.BlocksA}"
                         HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                         SelectionMode="Extended" SelectionChanged="Block_SelectionChanged"
                         MaxHeight="104" MinHeight="40"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         ItemContainerStyle="{StaticResource MemoryBlockListItemContainerStyle}"
                         ItemTemplate="{StaticResource MemoryBlockListItemTemplate}">
                </ListBox>
                </GroupBox>
                <GroupBox Grid.Row="0" Grid.Column="2" Margin="0,0,0,8" Header="{Binding Workspace.NameB}"
                          HeaderTemplate="{StaticResource MemoryBlockGroupHeaderTemplate}" MaxHeight="130">
                <ListBox x:Name="FileBBlocks" ItemsSource="{Binding Workspace.BlocksB}"
                         HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                         SelectionMode="Single" SelectionChanged="Block_SelectionChanged"
                         MaxHeight="104" MinHeight="40"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         ItemContainerStyle="{StaticResource MemoryBlockListItemContainerStyle}"
                         ItemTemplate="{StaticResource MemoryBlockListItemTemplate}">
                </ListBox>
                </GroupBox>
            <local:HexViewControl x:Name="FileAView" Grid.Row="1" Grid.Column="0"
                                  ItemsSource="{Binding ViewModel.FileARows}"
                                  BytesPerRow="{Binding ViewModel.BytesPerRow}"
                                  ShowAscii="{Binding ViewModel.ShowAscii}"
                                  AddressRangeSelected="ByteAddressSelected" />
            <GridSplitter Grid.Row="1" Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="{DynamicResource HexWindowBrush}" />
            <local:HexViewControl x:Name="FileBView" Grid.Row="1" Grid.Column="2"
                                  ItemsSource="{Binding ViewModel.FileBRows}"
                                  BytesPerRow="{Binding ViewModel.BytesPerRow}"
                                  ShowAscii="{Binding ViewModel.ShowAscii}"
                                  AddressRangeSelected="ByteAddressSelected" />
        </Grid>
    </DockPanel>
</UserControl>
