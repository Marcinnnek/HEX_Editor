<UserControl x:Class="HexEditor.UI.CompareView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HexEditor.UI"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SegmentListStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10,7"
                BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                CornerRadius="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <TextBlock Text="{Binding ViewModel.ComparisonStatus}" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10" VerticalAlignment="Center">
            <TextBlock Text="Bytes per row" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="RowWidthBox" Width="72" MinHeight="28" IsEditable="True" IsTextSearchEnabled="False"
                      Style="{StaticResource {x:Type ComboBox}}" ItemsSource="{Binding RowWidths}"
                      Text="{Binding ViewModel.BytesPerRow, Mode=OneWay}"
                      SelectionChanged="RowWidthBox_SelectionChanged"
                      PreviewTextInput="RowWidthBox_PreviewTextInput"
                      PreviewKeyDown="RowWidthBox_PreviewKeyDown"
                      LostKeyboardFocus="RowWidthBox_LostKeyboardFocus"
                      DataObject.Pasting="RowWidthBox_Pasting" />
            <CheckBox Content="Show ASCII" IsChecked="{Binding ViewModel.ShowAscii}" VerticalAlignment="Center" Margin="14,0" />
            <ComboBox x:Name="ViewModeBox" Width="150" ItemsSource="{Binding ViewModes}" SelectedItem="{Binding ViewModel.ViewMode}" />
            <TextBlock Text="Start" VerticalAlignment="Center" Margin="10,0,4,0" />
            <ui:TextBox x:Name="RangeStartBox" Width="92" Text="00000000" />
            <TextBlock Text="End" VerticalAlignment="Center" Margin="8,0,4,0" />
            <ui:TextBox x:Name="RangeEndBox" Width="92" Text="FFFFFFFF" />
            <ui:Button Content="Apply range" Margin="5,0" Padding="8,3" Click="ApplyRange_Click" />
            <ui:TextBox x:Name="AddressBox" Width="110" Margin="12,0,0,0" VerticalContentAlignment="Center" />
            <ui:Button Content="Go" Margin="4,0" Padding="8,3" Click="Go_Click" />
            <ui:Button Content="Previous difference" Margin="10,0,3,0" Padding="8,3" Click="PreviousDifference_Click" />
            <ui:Button Content="Next difference" Padding="8,3" Click="NextDifference_Click" />
        </WrapPanel>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <GroupBox Grid.Row="0" Grid.Column="0" Margin="0,0,0,8" Header="{Binding Workspace.NameA}" MaxHeight="130">
                <ListBox x:Name="FileABlocks" ItemsSource="{Binding Workspace.BlocksA}"
                         HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                         SelectionMode="Extended" SelectionChanged="Block_SelectionChanged"
                         MaxHeight="104" MinHeight="40"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         ItemContainerStyle="{StaticResource MemoryBlockListItemContainerStyle}"
                         ItemTemplate="{StaticResource MemoryBlockListItemTemplate}">
                </ListBox>
                </GroupBox>
                <GroupBox Grid.Row="0" Grid.Column="2" Margin="0,0,0,8" Header="{Binding Workspace.NameB}" MaxHeight="130">
                <ListBox x:Name="FileBBlocks" ItemsSource="{Binding Workspace.BlocksB}"
                         HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                         SelectionMode="Single" SelectionChanged="Block_SelectionChanged"
                         MaxHeight="104" MinHeight="40"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         ItemContainerStyle="{StaticResource MemoryBlockListItemContainerStyle}"
                         ItemTemplate="{StaticResource MemoryBlockListItemTemplate}">
                </ListBox>
                </GroupBox>
            <local:HexViewControl x:Name="FileAView" Grid.Row="1" Grid.Column="0"
                                  ItemsSource="{Binding ViewModel.FileARows}"
                                  BytesPerRow="{Binding ViewModel.BytesPerRow}"
                                  ShowAscii="{Binding ViewModel.ShowAscii}"
                                  AddressRangeSelected="ByteAddressSelected" />
            <GridSplitter Grid.Row="1" Grid.Column="1" Width="8" HorizontalAlignment="Stretch" />
            <local:HexViewControl x:Name="FileBView" Grid.Row="1" Grid.Column="2"
                                  ItemsSource="{Binding ViewModel.FileBRows}"
                                  BytesPerRow="{Binding ViewModel.BytesPerRow}"
                                  ShowAscii="{Binding ViewModel.ShowAscii}"
                                  AddressRangeSelected="ByteAddressSelected" />
        </Grid>
    </DockPanel>
</UserControl>
